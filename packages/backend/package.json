{
  "name": "@repo/backend",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    "./confect/*": "./confect/*.ts",
    "./confect/_generated/*": "./confect/_generated/*.ts",
    "./convex/*": "./convex/*.ts",
    "./convex/_generated/api": "./convex/_generated/api.js"
  },
  "scripts": {
    "dev": "confect dev & printf 'n\\n' | convex dev --local --tail-logs always",
    "codegen": "confect codegen",
    "convex:dev": "convex dev --tail-logs",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "test": "vitest run"
  },
  "dependencies": {
    "@confect/cli": "8.0.0",
    "@confect/core": "8.0.0",
    "@confect/react": "8.0.0",
    "@confect/server": "8.0.0",
    "@repo/ai": "workspace:*",
    "convex": "1.39.1",
    "effect": "3.21.2",
    "nanoid": "5.1.6"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  }
}
