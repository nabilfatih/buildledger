{
  "name": "buildledger",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=web --filter=@repo/backend",
    "dev:web": "pnpm --filter web dev",
    "dev:backend": "pnpm --filter @repo/backend dev",
    "start": "turbo run dev --filter=web --filter=@repo/backend",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "ultracite check",
    "format": "ultracite fix",
    "clean": "git clean -xdf node_modules apps/*/node_modules packages/*/node_modules .turbo apps/*/.vinxi apps/*/.output packages/*/.turbo"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "25.9.1",
    "turbo": "2.9.14",
    "typescript": "6.0.3",
    "ultracite": "7.7.0",
    "vitest": "4.1.7"
  }
}
